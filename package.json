{
  "name": "chrome-extension-table-extract",
  "private": true,
  "version": "1.30.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanghaisheng/chrome-extension-table-extract.git"
  },
  "homepage": "https://github.com/wanghaisheng/chrome-extension-table-extract",
  "bugs": {
    "url": "https://github.com/wanghaisheng/chrome-extension-table-extract/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:e2e": "npm run test:pw",
    "test:unit": "jest -c ./jest.unit.config.cjs",
    "test:pw": "tsc && vite build --mode=e2e && playwright test",
    "pack:chrome": "npm run build && node scripts/pack.mjs --browsers=chrome",
    "pack:edge": "npm run build && node scripts/pack.mjs --browsers=edge",
    "pack:all": "npm run build && node scripts/pack.mjs --browsers=chrome,edge",
    "preview": "vite preview",
    "lint": "eslint src -c ./.eslintrc.cjs --ext .jsx,.js,.ts,.tsx",
    "check:syntax": "tsc --noEmit",
    "governance:readiness": "node scripts/governance/readiness.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:check:strict": "node scripts/docs/check.mjs --strict",
    "check-types": "tsc --noEmit",
    "prepare": "husky",
    "clean": "rm -rf dist"
  },
  "prettier": "@rows/prettier-config",
  "dependencies": {
    "eslint-plugin-import": "^2.29.1",
    "preact": "^10.19.3",
    "sql.js": "^1.14.1",
    "ua-parser-js": "^1.0.37",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@modyfi/vite-plugin-yaml": "^1.1.0",
    "@playwright/test": "^1.58.2",
    "@preact/preset-vite": "^2.8.1",
    "@types/chrome": "^0.0.293",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/sql.js": "^1.4.9",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^4.28.3",
    "@typescript-eslint/parser": "^4.0.0",
    "archiver": "^7.0.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^7.0.0",
    "eslint-plugin-prettier": "^3.1.1",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "prettier": "2.4",
    "ts-jest": "^29.2.5",
    "typescript": "^4.5.0",
    "vite": "^6.4.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
